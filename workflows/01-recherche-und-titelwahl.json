      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2800,
        240
      ],
      "parameters": {
        "jsCode": "const plan = $('Unterordner planen').all().map(i => i.json);\nconst neu = $input.all().map(i => i.json);\n\nconst map = {};\nfor (let i = 0; i < plan.length; i++) {\n  const id = String(((neu[i] || {}).id) || '');\n  if (!id) throw new Error('Unterordner \"' + plan[i].name + '\" konnte nicht angelegt werden.');\n  map[plan[i].slot] = id;\n}\n\nreturn [{ json: {\n  pins_ordner_id: map.pins || '',\n  affiliate_ordner_id: map.affiliate || '',\n  etsy_ordner_id: map.etsy || ''\n} }];"
      }
