    {
      "id": "n_kontext",
      "name": "Kontext bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        592,
        -280
      ],
      "parameters": {
        "jsCode": "// Baut den Kontext bereits veroeffentlichter Buecher fuer den Recherche-Agenten\n// und als Vergleichsbasis fuer die spaetere Aehnlichkeitspruefung.\n\nconst zeilen = [];\nconst roh = [];\n\nfor (const item of $input.all()) {\n  const b = item.json || {};\n  const titel = String(b['Buchtitel'] || '').trim();\n  if (!titel) continue;\n\n  let kapitel = [];\n  try {\n    const p = JSON.parse(String(b['Planungsdaten (JSON)'] || '{}'));\n    kapitel = (p.kapitel || []).map(k => String((k && k.kapitel_titel_kurz) || '')).filter(Boolean);\n  } catch (e) { kapitel = []; }\n\n  const eintrag = {\n    titel: titel,\n    untertitel: String(b['Untertitel'] || '').trim(),\n    nische: String(b['Nische'] || '').trim(),\n    kapitel: kapitel\n  };\n  roh.push(eintrag);\n\n  const kapText = kapitel.length ? kapitel.join('; ') : '(nicht dokumentiert)';\n  zeilen.push('- ' + titel + ' | Nische: ' + (eintrag.nische || 'unbekannt') + ' | Kapitel: ' + kapText);\n}\n\nlet blacklist = '';\ntry { blacklist = String($('Aggregate').first().json['Bisherige Nischen'] || ''); } catch (e) { blacklist = ''; }\n\nreturn [{ json: {\n  bisherige_buecher: zeilen.length ? zeilen.join('\\n') : '(noch keine veroeffentlichten Buecher)',\n  buecher_roh: roh,\n  anzahl_buecher: roh.length,\n  blacklist_nischen: blacklist\n} }];"
      }
    },
    {
      "id": "n_sim",
      "name": "Aehnlichkeit pruefen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        -96
      ],
      "parameters": {
        "jsCode": "// Vergleicht das neue Buchkonzept mit allen bereits veroeffentlichten Buechern.\n// Ab HART wird die Produktion gestoppt, ab WARN nur markiert.\n\nconst HART = 0.65;\nconst WARN = 0.45;\n\nconst STOPP = new Set(['der','die','das','und','fuer','mit','von','im','in','ein','eine','einen','einem','eines','auf','bei','aus','als','auch','nach','ueber','den','dem','des','sich','ist','sind','wie','mehr','ohne','durch','vor','wird','werden','kann','koennen','man','ihre','ihrem','deine','deinem','meine','dass','nicht','oder','aber','was','wer','wenn','dann','noch','nur','schon','beim','zum','zur','vom','ins','sowie','damit','dabei','diese','dieser','dieses','jeder','jede','jedes','alle','allen','ratgeber','buch','buches','kapitel','titel','untertitel','nische','beschreibung','optionen','haupttitel','output','kapiteltitel','kurz','praktisch','richtig','endlich','einfach','besser','wichtig','sollten','sollte']);\n\nfunction tokens(text) {\n  return String(text || '')\n    .toLowerCase()\n    .replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss')\n    .replace(/[^a-z0-9\\s]/g, ' ')\n    .split(/\\s+/)\n    .filter(w => w.length >= 4 && !STOPP.has(w));\n}\n\nfunction jaccard(a, b) {\n  if (!a.size || !b.size) return 0;\n  let schnitt = 0;\n  a.forEach(x => { if (b.has(x)) schnitt++; });\n  return schnitt / (a.size + b.size - schnitt);\n}\n\nconst rein = $input.first().json || {};\nconst neu = new Set(tokens(JSON.stringify(rein.output || {})));\n\nlet alte = [];\ntry { alte = $('Kontext bauen').first().json.buecher_roh || []; } catch (e) { alte = []; }\n\nlet best = 0;\nlet bestesBuch = '';\nconst alleScores = [];\n\nfor (const b of alte) {\n  const altText = [b.titel, b.untertitel, b.nische, (b.kapitel || []).join(' ')].join(' ');\n  const s = jaccard(neu, new Set(tokens(altText)));\n  alleScores.push({ titel: b.titel, score: Math.round(s * 100) / 100 });\n  if (s > best) { best = s; bestesBuch = b.titel; }\n}\n\nalleScores.sort((x, y) => y.score - x.score);\nconst score = Math.round(best * 100) / 100;\n\nif (score >= HART) {\n  throw new Error('ABBRUCH wegen Aehnlichkeit: Das neue Konzept ueberschneidet sich zu stark mit \"' + bestesBuch + '\" (Score ' + score + ', Grenze ' + HART + '). Produktion gestoppt, bevor Kosten entstehen. Bitte WF01 erneut starten.');\n}\n\nreturn [{ json: Object.assign({}, rein, {\n  aehnlichkeit_score: score,\n  aehnlichstes_buch: bestesBuch,\n  aehnlichkeit_warnung: score >= WARN,\n  aehnlichkeit_top3: alleScores.slice(0, 3),\n  verglichen_mit: alte.length\n}) }];"
      }
    },
    {
      "id": "n_subplan",
      "name": "Unterordner planen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
