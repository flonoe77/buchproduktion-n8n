      "parameters": {
        "jsCode": "// Die Unterordner werden EINMAL beim Anlegen des Buches erzeugt.\n// Kein spaeteres Suchen oder Anlegen in WF03/07/08/09 mehr.\nconst parent = String(($('Ordner_erstellen').first().json || {}).id || '');\nif (!parent) throw new Error('Buchordner-ID fehlt, Unterordner koennen nicht angelegt werden.');\n\nreturn [\n  { json: { slot: 'pins', name: 'Buch-Pins', parent: parent } },\n  { json: { slot: 'affiliate', name: 'Affiliate-Pins', parent: parent } },\n  { json: { slot: 'etsy', name: 'Etsy', parent: parent } }\n];"
      }
    },
